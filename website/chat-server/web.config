<?xml version="1.0" encoding="utf-8"?>
<!-- IIS 下 /api 应用的配置（部署脚本会复制到发布目录，覆盖 SDK 生成的那份） -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Starline.Chat.dll" stdoutLogEnabled="true" stdoutLogFile="C:\starline-data\chat\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="STARLINE_CHAT_DATA" value="C:\starline-data\chat" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="65536" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
