<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test runner. Run with: dotnet run, from the repo root pointing at this project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Starline.Battle/Starline.Battle.csproj" />
  </ItemGroup>

</Project>
