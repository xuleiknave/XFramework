/*
 * Starline UI theme. Every screen uses these classes; layouts are designed for 3840 x 2160 (4K)
 * and scaled to the screen height (see Ui.ConfigurePanel).
 */

:root, .starline {
    --bg: #0B111B;
    --bg-dim: rgba(5, 8, 14, 0.72);
    --panel: rgba(18, 26, 39, 0.94);
    --panel-solid: #121A27;
    --panel-raised: #1A2536;
    --border: #2C3A50;
    --text: #E3E9F2;
    --muted: #93A1B5;
    --primary: #5AB8FF;
    --primary-dark: #13243A;
    --good: #6FD08C;
    --warn: #E8C15A;
    --bad: #FF6B6B;
    --enemy: #FF8F4A;
    --elite: #E8C15A;
    --supply: #6FD0B4;
}

/* ---- Layout -------------------------------------------------------------- */

.starline {
    color: var(--text);
    font-size: 36px;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.fill {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.screen {
    flex-grow: 1;
}

.backdrop {
    background-color: var(--bg);
}

.center {
    align-items: center;
    justify-content: center;
}

.row {
    flex-direction: row;
}

.column {
    flex-direction: column;
}

.grow {
    flex-grow: 1;
}

.spacer {
    flex-grow: 1;
    min-height: 19px;
}

.section {
    margin-top: 34px;
}

.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--border);
    border-radius: 14px;
    padding: 34px 38px;
}

/* ---- Text ---------------------------------------------------------------- */

Label {
    white-space: normal;
}

.h1 {
    font-size: 67px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.h2 {
    font-size: 48px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.h3 {
    font-size: 38px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.body {
    font-size: 34px;
    margin-bottom: 10px;
}

.small {
    font-size: 29px;
    margin-bottom: 5px;
}

.big {
    font-size: 115px;
    -unity-font-style: bold;
    color: var(--primary);
}

.stat {
    font-size: 38px;
    -unity-font-style: bold;
    margin: 10px 0;
}

.muted { color: var(--muted); }
.good { color: var(--good); }
.warn { color: var(--warn); }
.bad { color: var(--bad); }

/* ---- Buttons ------------------------------------------------------------- */

.btn {
    background-color: var(--panel-raised);
    border-width: 2px;
    border-color: var(--border);
    border-radius: 12px;
    color: var(--text);
    font-size: 34px;
    padding: 14px 29px;
    margin: 10px 0;
    min-height: 82px;
    -unity-text-align: middle-center;
    white-space: normal;
    transition-duration: 0.12s;
}

.btn:hover {
    border-color: var(--primary);
    background-color: #22324A;
}

.btn:active {
    background-color: var(--primary-dark);
}

.btn:disabled {
    opacity: 0.4;
}

.btn-primary {
    background-color: #1D4E7A;
    border-color: var(--primary);
    -unity-font-style: bold;
}

.btn-primary:hover {
    background-color: #2A649A;
}

.btn-secondary {
    background-color: transparent;
}

.btn-large {
    min-height: 125px;
    font-size: 43px;
}

.btn-small {
    min-height: 72px;
    padding: 5px 24px;
    margin: 0 0 0 14px;
}

.btn-toggled {
    background-color: var(--primary-dark);
    border-color: var(--primary);
    color: var(--primary);
}

/* ---- Main menu ----------------------------------------------------------- */

.menu-card {
    width: 1104px;
    padding: 86px 96px;
}

.logo {
    font-size: 134px;
    -unity-font-style: bold;
    color: var(--primary);
    -unity-text-align: middle-center;
    letter-spacing: 29px;
}

.logo-sub {
    font-size: 53px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.tagline {
    font-size: 34px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-bottom: 58px;
}

.version {
    position: absolute;
    right: 48px;
    bottom: 34px;
}

/* ---- Star map ------------------------------------------------------------ */

.sidebar {
    width: 768px;
    margin: 38px;
}

.map-area {
    flex-grow: 1;
    padding: 67px 96px 96px 58px;
}

.map-canvas {
    flex-grow: 1;
    margin-top: 58px;
}

.star-map {
    flex-grow: 1;
}

.node {
    position: absolute;
    margin: 0;
    font-size: 31px;
    border-width: 5px;
    border-radius: 19px;
}

.node--battle { border-color: var(--primary); }
.node--elite { border-color: var(--elite); }
.node--supply { border-color: var(--supply); }
.node--boss { border-color: var(--enemy); background-color: #3A1F17; }

.node--open {
    background-color: #1D3550;
}

.node--closed {
    opacity: 0.45;
}

.node--closed:hover {
    background-color: var(--panel-raised);
}

.node--visited {
    opacity: 0.8;
    background-color: #1C3326;
    border-color: var(--good);
}

.node--current {
    opacity: 1;
    border-color: var(--good);
    background-color: #24503A;
}

.info-box {
    background-color: var(--panel-raised);
    border-radius: 12px;
    padding: 24px 29px;
    margin-bottom: 19px;
}

.messages {
    margin-top: 24px;
}

/* ---- Deployment and battle bars ---------------------------------------- */

.topbar {
    flex-direction: row;
    align-items: center;
    height: 125px;
    padding: 0 38px;
    background-color: var(--panel);
    border-bottom-width: 2px;
    border-color: var(--border);
}

.topbar .h2 {
    margin-bottom: 0;
}

.hint {
    margin-left: 58px;
}

.side-left {
    width: 600px;
    margin: 19px;
}

.side-right {
    width: 816px;
    margin: 19px;
}

.roster {
    margin: 14px 0;
}

.roster-card {
    flex-direction: column;
    align-items: stretch;
    -unity-text-align: upper-left;
    padding: 14px 24px;
    margin: 0 0 14px 0;
}

.roster-card-head {
    flex-direction: row;
    justify-content: space-between;
}

.roster-card-title {
    font-size: 34px;
    -unity-font-style: bold;
}

.roster-card-state {
    font-size: 29px;
    color: var(--muted);
}

.roster-card--deployed {
    border-color: var(--good);
    background-color: #17271F;
}

.roster-card--selected {
    border-color: var(--primary);
    background-color: var(--primary-dark);
}

.count {
    min-width: 336px;
}

.speeds {
    margin-left: 58px;
}

.feed {
    width: 720px;
    margin: 19px 29px;
}

.bottombar {
    flex-direction: row;
    align-items: center;
    height: 269px;
    padding: 24px 38px;
    background-color: var(--panel);
    border-top-width: 2px;
    border-color: var(--border);
}

.supply-box {
    width: 864px;
}

.pips {
    margin: 14px 0;
}

.pip {
    width: 62px;
    height: 29px;
    margin-right: 10px;
    background-color: #202838;
    border-radius: 5px;
}

.pip--full {
    background-color: var(--good);
}

.net-box {
    width: 720px;
    margin-left: 58px;
}

.skill {
    width: 408px;
    height: 206px;
    margin: 0 0 0 24px;
    flex-direction: column;
    justify-content: center;
}

.skill-name {
    font-size: 38px;
    -unity-font-style: bold;
}

.skill--armed {
    border-color: var(--bad);
    background-color: #3A1A1A;
}

/* ---- Rewards ------------------------------------------------------------- */

.cards {
    margin: 58px 0;
}

.reward-card {
    width: 672px;
    height: 912px;
    margin: 0 34px;
}

.stats {
    margin-top: 19px;
}

/* ---- Dialogs ------------------------------------------------------------- */

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-dim);
    align-items: center;
    justify-content: center;
}

.dialog {
    width: 1440px;
    padding: 58px 67px;
}

.dialog-body {
    margin: 24px 0 38px 0;
}

.dialog-buttons {
    flex-direction: column;
}

.dialog--win { border-color: var(--good); }
.dialog--loss { border-color: var(--bad); }

/* ---- Labels over the ships ---------------------------------------------- */

.unit-tag {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
}

.unit-tag-status {
    font-size: 26px;
    color: var(--text);
    margin: 0;
}

.unit-tag-name {
    font-size: 26px;
    color: var(--muted);
    margin: 0;
}

.unit-bars {
    height: 14px;
    background-color: rgba(0, 0, 0, 0.6);
    margin: 2px 0;
}

.unit-bars--small { width: 82px; }
.unit-bars--large { width: 125px; }

.unit-bar-hp {
    position: absolute;
    left: 0;
    top: 0;
    height: 7px;
}

.unit-bar-hp--player { background-color: #66E680; }
.unit-bar-hp--enemy { background-color: #FF8059; }

.unit-bar-shield {
    position: absolute;
    left: 0;
    top: 7px;
    height: 5px;
    background-color: #73CCFF;
}
