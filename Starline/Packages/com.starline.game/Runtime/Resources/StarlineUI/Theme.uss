/*
 * Starline UI theme. Every screen uses these classes; layouts are designed for 3840 x 2160 (4K)
 * and scaled to the screen height (see Ui.ConfigurePanel); in portrait, 2160 x 3840 scaled to
 * the width, with the overrides in the "Portrait" section.
 * Style "星图" (docs/art-direction.md, decision 64): the screens read like a star chart. Deep indigo
 * night, panels outlined in faint starlight with a glowing mana node on two corners (.star-node),
 * starlight-ivory primary buttons, pill-shaped secondary buttons, serif titles, and the mana teal
 * for every line, node, selection and progress bar: the "star lines" of the Mana Web.
 */

:root, .starline {
    --bg: #0B0C22;
    --bg-dim: rgba(6, 7, 20, 0.78);
    --panel: rgba(14, 15, 42, 0.92);
    --panel-solid: #0E0F2A;
    --panel-raised: #181A40;
    --border: #2C2F5C;
    --line: rgba(236, 227, 200, 0.32);
    --gold: #BFAE7E;
    --gold-bright: #F3E2AE;
    --gold-button: #EBD9A4;
    --gold-ink: #17142E;
    --text: #ECE6D6;
    --muted: #9A9CC4;
    --dim: #5E6188;
    --pressed: #0A0B20;
    --primary: #5AB8FF;
    --primary-dark: #13243A;
    --good: #6FD08C;
    --warn: #E8C15A;
    --bad: #FF6B6B;
    --enemy: #FF8F4A;
    --elite: #E8C15A;
    --supply: #6CF0DA;
}

/* ---- Layout -------------------------------------------------------------- */

.starline {
    color: var(--text);
    font-size: 36px;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.fill {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.screen {
    flex-grow: 1;
}

.backdrop {
    background-color: var(--bg);
}

.center {
    align-items: center;
    justify-content: center;
}

.row {
    flex-direction: row;
}

.column {
    flex-direction: column;
}

.grow {
    flex-grow: 1;
}

.spacer {
    flex-grow: 1;
    min-height: 19px;
}

.section {
    margin-top: 34px;
}

.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 3px;
    padding: 34px 38px;
}

/* ---- Text ---------------------------------------------------------------- */

Label {
    white-space: normal;
}

.h1 {
    font-size: 67px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    letter-spacing: 10px;
    margin-bottom: 14px;
}

.h2 {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-bottom: 10px;
}

.h3 {
    font-size: 38px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.body {
    font-size: 34px;
    margin-bottom: 10px;
}

.small {
    font-size: 29px;
    margin-bottom: 5px;
}

.big {
    font-size: 115px;
    -unity-font-style: bold;
    color: var(--text);
}

.stat {
    font-size: 38px;
    -unity-font-style: bold;
    margin: 10px 0;
}

/* Title faces: the Cinzel logo and serif titles (Noto Serif SC cut to the characters in the language
   tables and config, see tools/fonts/subset_title_font.py). Only for text from those tables: names
   that players type keep the body font, which has every character. */
.menu-logo,
.logo,
.settings-logo {
    -unity-font-definition: resource("StarlineLogoFont");
}

.h1,
.h2,
.menu-title,
.menu-item-title,
.menu-place-title,
.login-heading,
.login-main-title,
.settings-page-title,
.slot-new {
    -unity-font-definition: resource("StarlineTitleFont");
}

.muted { color: var(--muted); }
.good { color: var(--good); }
.warn { color: var(--warn); }
.bad { color: var(--bad); }

/* ---- Buttons ------------------------------------------------------------- */

.btn {
    background-color: var(--panel-raised);
    border-width: 2px;
    border-color: var(--border);
    border-radius: 5px;
    color: var(--text);
    font-size: 34px;
    padding: 14px 29px;
    margin: 10px 0;
    min-height: 82px;
    -unity-text-align: middle-center;
    white-space: normal;
    transition-duration: 0.12s;
}

.btn:hover {
    border-color: var(--gold-bright);
    background-color: #1F2250;
}

.btn:active {
    background-color: var(--pressed);
}

.btn:disabled {
    opacity: 0.4;
}

.btn-primary {
    background-color: var(--gold-button);
    border-color: #FFF4D2;
    color: var(--gold-ink);
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.btn-primary:hover {
    background-color: #FFF0C8;
    border-color: var(--supply);
}

.btn-primary:active {
    background-color: #D4C08A;
}

/* Secondary buttons are pills, so they never read as panels. */
.btn-secondary {
    background-color: transparent;
    border-color: var(--gold);
    color: var(--gold-bright);
    border-radius: 41px;
}

.btn-large {
    min-height: 125px;
    font-size: 43px;
}

.btn-small {
    min-height: 72px;
    padding: 5px 34px;
    border-radius: 36px;
    margin: 0 0 0 14px;
}

.btn-toggled {
    background-color: var(--pressed);
    border-color: var(--gold-bright);
    color: var(--gold-bright);
}

/* ---- Main menu ----------------------------------------------------------- */

/* Shades over the 3D menu scene (MenuScene) so the text stays readable; USS has no
   gradients, so they are small textures stretched to fit. */
.shade-left {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-image: resource("StarlineUI/FadeLeft");
    -unity-background-scale-mode: stretch-to-fill;
}

.shade-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 22%;
    background-image: resource("StarlineUI/FadeBottom");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Left column over the 3D background (design: 1600 x 900 artboard, x2.4 here). */
.menu-column {
    position: absolute;
    left: 230px;
    top: 221px;
    width: 960px;
}

.menu-logo {
    font-size: 134px;
    color: var(--gold-bright);
    letter-spacing: 29px;
    margin: 0;
}

.menu-divider {
    align-items: center;
    margin: 34px 0;
}

.diamond--start {
    margin: 0 34px 0 0;
}

.menu-title {
    font-size: 82px;
    -unity-font-style: bold;
    letter-spacing: 38px;
    margin: 0 0 34px 0;
}

.menu-tagline {
    font-size: 36px;
    color: var(--muted);
    margin: 0 0 86px 0;
}

/* A menu entry: title on the left, a short status on the right; gold bar on the left when highlighted. */
.menu-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 14px 0;
    padding: 34px 43px;
    background-color: transparent;
    border-width: 0;
    border-left-width: 5px;
    border-color: transparent;
    border-radius: 0;
    transition-duration: 0.12s;
}

.menu-item:hover,
.menu-item--on {
    border-color: var(--supply);
    background-color: rgba(108, 240, 218, 0.08);
}

.menu-item:active {
    background-color: rgba(108, 240, 218, 0.16);
}

.menu-item-title {
    font-size: 50px;
    -unity-font-style: bold;
    color: var(--text);
    letter-spacing: 5px;
    margin: 0;
}

.menu-item:hover .menu-item-title,
.menu-item--on .menu-item-title {
    color: var(--gold-bright);
}

.menu-item-sub {
    font-size: 31px;
    color: var(--muted);
    margin: 0;
}

.menu-item:disabled {
    border-color: transparent;
    background-color: transparent;
}

.menu-item:disabled .menu-item-title {
    color: var(--dim);
}

.menu-small {
    margin-top: 53px;
}

.menu-small .btn-small {
    margin: 0 29px 0 0;
}

.menu-version {
    position: absolute;
    left: 230px;
    bottom: 77px;
    color: var(--dim);
}

.menu-place {
    position: absolute;
    right: 115px;
    bottom: 77px;
    align-items: flex-end;
}

.menu-place-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin: 0;
}

/* Signed-in account under the commander, top right of the main menu. */
.menu-account {
    position: absolute;
    right: 115px;
    top: 226px;
}

/* Login screen: the brand from the main menu, then a card with one big button per login method,
   the progress or error right under it, and the developer login below a divider. */
.login-tagline {
    margin-bottom: 58px;
}

.login-card {
    padding: 53px 58px 48px 58px;
}

.login-heading {
    font-size: 53px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    letter-spacing: 10px;
    margin: 0;
}

.login-heading-sub {
    font-size: 31px;
    color: var(--muted);
    margin: 10px 0 43px 0;
}

.login-main {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 197px;
    margin: 0;
    padding: 29px 43px;
}

.login-main-title {
    font-size: 53px;
    -unity-font-style: bold;
    letter-spacing: 14px;
    margin: 0;
}

.login-main-sub {
    font-size: 29px;
    color: #5A4C2A;
    letter-spacing: 2px;
    margin: 10px 0 0 0;
}

.login-status-row {
    align-items: center;
    min-height: 82px;
    margin-top: 29px;
}

/* Turned by LoginScreen while a login runs. */
.login-spinner {
    width: 29px;
    height: 29px;
    margin: 0 29px 0 10px;
    flex-shrink: 0;
    border-width: 5px;
    border-color: var(--supply);
    border-top-color: transparent;
    border-radius: 50%;
}

.login-status {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 34px;
    color: var(--muted);
    white-space: normal;
    margin: 0;
}

.login-status.bad {
    color: var(--bad);
}

.login-card--busy .login-status {
    color: var(--supply);
}

.login-cancel {
    flex-shrink: 0;
    margin: 0 0 0 29px;
}

.login-dev {
    margin-top: 34px;
}

.login-dev-head {
    align-items: center;
    margin-bottom: 24px;
}

.login-dev-line {
    flex-grow: 1;
    height: 2px;
    background-color: var(--border);
}

.login-dev-title {
    font-size: 29px;
    color: var(--muted);
    letter-spacing: 5px;
    margin: 0 29px;
}

.login-dev-row {
    align-items: center;
}

.login-dev-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 24px 0 0;
}

.login-dev .login-dev-field .unity-base-text-field__input,
.login-dev .login-dev-field .unity-text-field__input {
    font-size: 38px;
    letter-spacing: 2px;
    min-height: 86px;
    padding: 14px 29px;
    border-color: var(--border);
}

.login-dev .login-dev-field:focus .unity-base-text-field__input,
.login-dev .login-dev-field .unity-base-text-field__input:focus {
    border-color: var(--gold-bright);
}

.login-dev-button {
    flex-shrink: 0;
    min-height: 86px;
    margin: 0;
}

.login-dev-hint {
    margin: 19px 0 0 0;
}

/* Settings and quit, top right where the main menu shows the commander. */
.login-corner {
    position: absolute;
    right: 115px;
    top: 96px;
}

.login-corner .btn-small {
    margin: 0 0 0 29px;
}

/* Logo used by the save-slot screen. */
.logo {
    font-size: 134px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    letter-spacing: 29px;
}

.logo-sub {
    font-size: 53px;
    -unity-font-style: bold;
    color: var(--text);
    letter-spacing: 38px;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.tagline {
    font-size: 34px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-bottom: 58px;
}

.commander {
    position: absolute;
    right: 115px;
    top: 96px;
    padding: 24px 43px;
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 5px;
    font-size: 34px;
    color: var(--gold-bright);
}

/* ---- Save slots ---------------------------------------------------------- */

.slots {
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 12, 34, 0.74);
}

.slots-head {
    align-items: center;
    margin-bottom: 115px;
}

.slots .logo {
    font-size: 154px;
    letter-spacing: 34px;
}

.slots .logo-sub {
    font-size: 86px;
    letter-spacing: 48px;
    margin: 14px 0 10px 48px;
}

.slots .tagline {
    margin-bottom: 0;
}

.divider {
    width: 1056px;
    align-items: center;
    margin-top: 24px;
}

.divider-line {
    flex-grow: 1;
    height: 2px;
    background-color: var(--supply);
    opacity: 0.7;
}

/* A star on the chart: the end of a star line. */
.diamond {
    width: 19px;
    height: 19px;
    margin: 0 29px;
    background-color: var(--bg);
    border-width: 4px;
    border-color: var(--supply);
    border-radius: 50%;
}

/* Glowing mana nodes on two corners of a panel: the panel is a star on the chart. Put them as the
   panel's last children so they draw over its border. */
.star-node {
    position: absolute;
    width: 22px;
    height: 22px;
    background-color: var(--bg);
    border-width: 4px;
    border-color: var(--supply);
    border-radius: 50%;
}

.star-node--tl {
    left: -12px;
    top: -12px;
}

.star-node--br {
    right: -12px;
    bottom: -12px;
}

.eyebrow {
    letter-spacing: 10px;
}

.slots-row {
    margin-bottom: 72px;
}

.slot-card {
    width: 816px;
    height: 720px;
    margin: 0 43px;
    padding: 58px 62px 34px 62px;
    border-radius: 5px;
    transition-duration: 0.12s;
}

.slot-card:hover {
    border-color: var(--gold-bright);
}

.slot-card--selected {
    border-color: var(--gold-bright);
    background-color: var(--panel-raised);
    translate: 0 -14px;
}

.slot-card--empty {
    background-color: rgba(11, 12, 34, 0.7);
    border-color: var(--line);
    align-items: center;
    justify-content: center;
}

.slot-name {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    letter-spacing: 10px;
    margin: 10px 0;
}

.slot-line {
    height: 2px;
    background-color: var(--supply);
    opacity: 0.6;
    margin: 14px 0 24px 0;
}

.slot-row {
    justify-content: space-between;
    font-size: 34px;
    margin-bottom: 14px;
}

.slot-foot {
    justify-content: flex-end;
}

.slot-plus {
    font-size: 106px;
    color: var(--gold);
    margin: 24px 0 10px 0;
}

.slot-new {
    font-size: 53px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    letter-spacing: 10px;
    margin-bottom: 14px;
}

.btn-text {
    background-color: transparent;
    border-color: transparent;
    color: var(--muted);
}

.btn-text:hover {
    background-color: transparent;
    border-color: transparent;
    color: var(--bad);
}

.slots-enter {
    min-width: 840px;
    letter-spacing: 14px;
}

.slots-corner {
    position: absolute;
    right: 115px;
    bottom: 62px;
}

.name-dialog {
    width: 1440px;
}

.name-field {
    margin: 10px 0;
}

.name-field .unity-base-text-field__input,
.name-field .unity-text-field__input {
    background-color: var(--bg);
    border-width: 2px;
    border-color: var(--gold-bright);
    border-radius: 5px;
    color: var(--text);
    font-size: 58px;
    letter-spacing: 10px;
    padding: 24px 38px;
    min-height: 130px;
}

.name-hints {
    justify-content: space-between;
}

.name-error {
    min-height: 43px;
}

.name-buttons {
    margin-top: 24px;
}

.name-buttons .btn {
    margin: 0;
}

.name-buttons .btn-primary {
    margin-right: 38px;
}

/* ---- Star map ------------------------------------------------------------ */

.sidebar {
    width: 768px;
    margin: 38px;
}

.map-area {
    flex-grow: 1;
    padding: 67px 96px 96px 58px;
}

.map-canvas {
    flex-grow: 1;
    margin-top: 58px;
}

.star-map {
    flex-grow: 1;
}

.node {
    position: absolute;
    margin: 0;
    font-size: 31px;
    border-width: 5px;
    border-radius: 19px;
}

.node--battle { border-color: var(--gold); }
.node--elite { border-color: var(--elite); }
.node--supply { border-color: var(--supply); }
.node--boss { border-color: var(--enemy); background-color: #3A1F17; }

.node--open {
    background-color: #2A2410;
    border-color: var(--gold-bright);
}

.node--closed {
    opacity: 0.45;
}

.node--closed:hover {
    background-color: var(--panel-raised);
}

.node--visited {
    opacity: 0.8;
    background-color: #0F2A28;
    border-color: var(--supply);
}

.node--current {
    opacity: 1;
    border-color: var(--supply);
    background-color: #164038;
}

.info-box {
    background-color: var(--panel-raised);
    border-left-width: 5px;
    border-color: var(--gold);
    border-radius: 2px;
    padding: 24px 29px;
    margin-bottom: 19px;
}

.messages {
    margin-top: 24px;
}

/* ---- Deployment and battle bars ---------------------------------------- */

.topbar {
    flex-direction: row;
    align-items: center;
    height: 125px;
    padding: 0 38px;
    background-color: var(--panel);
    border-bottom-width: 2px;
    border-color: var(--gold);
}

.topbar .h2 {
    margin-bottom: 0;
}

.hint {
    margin-left: 58px;
}

.side-left {
    width: 600px;
    margin: 19px;
}

.side-right {
    width: 816px;
    margin: 19px;
}

.roster {
    margin: 14px 0;
}

.roster-card {
    flex-direction: column;
    align-items: stretch;
    -unity-text-align: upper-left;
    padding: 14px 24px;
    margin: 0 0 14px 0;
}

.roster-card-head {
    flex-direction: row;
    justify-content: space-between;
}

.roster-card-title {
    font-size: 34px;
    -unity-font-style: bold;
}

.roster-card-state {
    font-size: 29px;
    color: var(--muted);
}

.roster-card--deployed {
    border-color: var(--good);
    background-color: #17271F;
}

.roster-card--selected {
    border-color: var(--supply);
    background-color: #102A2A;
}

.count {
    min-width: 336px;
}

.speeds {
    margin-left: 58px;
}

.feed {
    width: 720px;
    margin: 19px 29px;
}

.bottombar {
    flex-direction: row;
    align-items: center;
    height: 269px;
    padding: 24px 38px;
    background-color: var(--panel);
    border-top-width: 2px;
    border-color: var(--gold);
}

.supply-box {
    width: 864px;
}

.pips {
    margin: 14px 0;
}

.pip {
    width: 62px;
    height: 29px;
    margin-right: 10px;
    background-color: #1E2046;
    border-radius: 5px;
}

.pip--full {
    background-color: var(--supply);
}

.net-box {
    width: 720px;
    margin-left: 58px;
}

.skill {
    width: 408px;
    height: 206px;
    margin: 0 0 0 24px;
    flex-direction: column;
    justify-content: center;
}

.skill-name {
    font-size: 38px;
    -unity-font-style: bold;
}

.skill--armed {
    border-color: var(--bad);
    background-color: #3A1A1A;
}

/* ---- Portrait (root gets .portrait when the screen is taller than wide) ----
 * Layouts are then 2160 px wide (see UiRoot). The board stands upright in the
 * middle; deployment panels move below it and the battle bars wrap.
 */

.portrait .hint {
    display: none;
}

.portrait .deploy-body .side-left {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 840px;
    height: 1180px;
}

.portrait .deploy-body .side-right {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 1224px;
    height: 1180px;
}

.portrait .board-area {
    margin-bottom: 1218px;
}

.portrait .topbar {
    flex-wrap: wrap;
    height: auto;
    min-height: 125px;
    padding: 14px 38px;
}

.portrait .count {
    min-width: 0;
    margin-right: 24px;
}

.portrait .speeds {
    margin-left: 24px;
}

.portrait .battle-body .feed {
    position: absolute;
    top: 0;
    right: 0;
    width: 880px;
}

.portrait .battle-bottombar {
    flex-wrap: wrap;
    height: auto;
}

.portrait .supply-box {
    width: 1040px;
}

.portrait .net-box {
    width: 960px;
    margin-left: 38px;
}

.portrait .skill {
    margin: 14px 24px 0 0;
}

/* ---- Rewards ------------------------------------------------------------- */

.cards {
    margin: 58px 0;
}

.reward-card {
    width: 672px;
    height: 912px;
    margin: 0 34px;
}

.stats {
    margin-top: 19px;
}

/* ---- Dialogs ------------------------------------------------------------- */

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-dim);
    align-items: center;
    justify-content: center;
}

.dialog {
    width: 1440px;
    padding: 58px 67px;
}

.dialog-body {
    margin: 24px 0 38px 0;
}

.dialog-buttons {
    flex-direction: column;
}

.dialog--win { border-color: var(--good); }
.dialog--loss { border-color: var(--bad); }

/* ---- Labels over the ships ---------------------------------------------- */

.unit-tag {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
}

.unit-tag-status {
    font-size: 26px;
    color: var(--text);
    margin: 0;
}

.unit-tag-name {
    font-size: 26px;
    color: var(--muted);
    margin: 0;
}

.unit-bars {
    height: 14px;
    background-color: rgba(0, 0, 0, 0.6);
    margin: 2px 0;
}

.unit-bars--small { width: 82px; }
.unit-bars--large { width: 125px; }

.unit-bar-hp {
    position: absolute;
    left: 0;
    top: 0;
    height: 7px;
}

.unit-bar-hp--player { background-color: #66E680; }
.unit-bar-hp--enemy { background-color: #FF8059; }

.unit-bar-shield {
    position: absolute;
    left: 0;
    top: 7px;
    height: 5px;
    background-color: #73CCFF;
}

/* ---- Replays ------------------------------------------------------------- */

.replay-banner {
    align-self: center;
    margin-top: 14px;
    padding: 10px 38px;
    font-size: 34px;
    color: var(--gold-bright);
    background-color: var(--bg-dim);
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 5px;
}

/* ---- Settings ------------------------------------------------------------ */
/* Design: art canvas boards "设置 · 画质" and "设置 · 语言" (1600 x 900, x2.4 here). */

.settings {
    background-color: rgba(11, 12, 34, 0.74);
}

.settings-column {
    position: absolute;
    left: 230px;
    top: 221px;
    width: 816px;
}

.settings-logo {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    letter-spacing: 19px;
    margin: 0;
}

.settings-column .menu-title {
    margin-bottom: 53px;
}

.settings-tab .menu-item-title {
    letter-spacing: 10px;
}

.settings-panel {
    position: absolute;
    left: 1248px;
    top: 221px;
    width: 2362px;
    padding: 62px 82px 48px 82px;
    border-radius: 5px;
}

.settings-head {
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 19px;
}

.settings-page-title {
    font-size: 62px;
    letter-spacing: 14px;
    margin: 0;
}

.settings-row {
    justify-content: space-between;
    align-items: center;
    padding: 22px 0;
    border-bottom-width: 2px;
    border-color: var(--border);
}

.settings-row--last {
    border-bottom-width: 0;
}

.settings-row-text {
    flex-shrink: 1;
    margin-right: 48px;
}

.settings-key {
    font-size: 41px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    margin: 0;
}

.settings-desc {
    font-size: 29px;
    color: var(--muted);
    margin: 7px 0 0 0;
}

/* Segmented choice: one chip per option, the chosen one outlined in gold. */
.settings-seg {
    flex-shrink: 0;
}

.settings-chip {
    min-width: 149px;
    min-height: 77px;
    margin: 0 0 0 14px;
    padding: 10px 29px;
    font-size: 34px;
    color: #C9CCD3;
}

.settings-chip--on {
    background-color: var(--pressed);
    border-color: var(--gold-bright);
    color: var(--gold-bright);
    -unity-font-style: bold;
}

.settings-stepper {
    align-items: center;
    flex-shrink: 0;
}

.settings-arrow {
    width: 86px;
    min-height: 82px;
    margin: 0;
    padding: 0;
    font-size: 48px;
    color: var(--gold-bright);
}

.settings-value {
    width: 432px;
    margin: 0;
    font-size: 36px;
    -unity-text-align: middle-center;
}

.settings-foot {
    justify-content: space-between;
    align-items: center;
    margin-top: 34px;
}

.settings-reset {
    margin: 0;
    padding: 5px 0;
}

.settings-reset:hover {
    color: var(--gold-bright);
}

.settings-device {
    color: var(--dim);
    margin: 0;
}

/* Cards keep 17px on each side; the row pulls itself out by the same amount so the outer edges line up. */
.settings-languages {
    margin: 43px -17px;
}

.settings-language {
    flex-grow: 1;
    flex-basis: 0;
    align-items: flex-start;
    margin: 0 17px;
    padding: 48px 58px;
    -unity-text-align: middle-left;
}

.settings-language--on {
    background-color: var(--pressed);
    border-color: var(--gold-bright);
}

.settings-language-name {
    font-size: 53px;
    -unity-font-style: bold;
    letter-spacing: 7px;
    margin: 0 0 19px 0;
}

.settings-language--on .settings-language-name {
    color: var(--gold-bright);
}

.settings-language-status {
    font-size: 31px;
    color: var(--muted);
    margin: 0;
}

.settings-language--on .settings-language-status {
    color: var(--supply);
    -unity-font-style: bold;
}

.settings-notes {
    border-top-width: 2px;
    border-color: var(--border);
    padding-top: 38px;
}

.settings-corner {
    position: absolute;
    right: 230px;
    bottom: 96px;
    align-items: center;
}

/* The title fonts are already bold; without this the bold style would thicken them a second time. */
.menu-logo,
.logo,
.settings-logo,
.h1,
.h2,
.menu-title,
.menu-item-title,
.menu-place-title,
.login-heading,
.login-main-title,
.settings-page-title,
.slot-new {
    -unity-font-style: normal;
}
