/*
 * Starline UI theme. Every screen uses these classes; layouts are designed for 3840 x 2160 (4K)
 * and scaled to the screen height (see Ui.ConfigurePanel); in portrait, 2160 x 3840 scaled to
 * the width, with the overrides in the "Portrait" section.
 * Style "星夜金边" (docs/art-direction.md): night-blue panels with thin gold borders, gold titles,
 * gold primary buttons, and the mana teal for selection and progress.
 */

:root, .starline {
    --bg: #0A1020;
    --bg-dim: rgba(5, 8, 16, 0.75);
    --panel: rgba(17, 26, 46, 0.94);
    --panel-solid: #111A2E;
    --panel-raised: #18233B;
    --border: #26314A;
    --gold: #B8954F;
    --gold-bright: #E8C77A;
    --gold-button: #D9B46A;
    --gold-ink: #1A1408;
    --text: #EDE6D6;
    --muted: #9AA5B8;
    --primary: #5AB8FF;
    --primary-dark: #13243A;
    --good: #6FD08C;
    --warn: #E8C15A;
    --bad: #FF6B6B;
    --enemy: #FF8F4A;
    --elite: #E8C15A;
    --supply: #6FD0B4;
}

/* ---- Layout -------------------------------------------------------------- */

.starline {
    color: var(--text);
    font-size: 36px;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.fill {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.screen {
    flex-grow: 1;
}

.backdrop {
    background-color: var(--bg);
}

.center {
    align-items: center;
    justify-content: center;
}

.row {
    flex-direction: row;
}

.column {
    flex-direction: column;
}

.grow {
    flex-grow: 1;
}

.spacer {
    flex-grow: 1;
    min-height: 19px;
}

.section {
    margin-top: 34px;
}

.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 5px;
    padding: 34px 38px;
}

/* ---- Text ---------------------------------------------------------------- */

Label {
    white-space: normal;
}

.h1 {
    font-size: 67px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    letter-spacing: 10px;
    margin-bottom: 14px;
}

.h2 {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-bottom: 10px;
}

.h3 {
    font-size: 38px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.body {
    font-size: 34px;
    margin-bottom: 10px;
}

.small {
    font-size: 29px;
    margin-bottom: 5px;
}

.big {
    font-size: 115px;
    -unity-font-style: bold;
    color: var(--text);
}

.stat {
    font-size: 38px;
    -unity-font-style: bold;
    margin: 10px 0;
}

.muted { color: var(--muted); }
.good { color: var(--good); }
.warn { color: var(--warn); }
.bad { color: var(--bad); }

/* ---- Buttons ------------------------------------------------------------- */

.btn {
    background-color: var(--panel-raised);
    border-width: 2px;
    border-color: var(--border);
    border-radius: 5px;
    color: var(--text);
    font-size: 34px;
    padding: 14px 29px;
    margin: 10px 0;
    min-height: 82px;
    -unity-text-align: middle-center;
    white-space: normal;
    transition-duration: 0.12s;
}

.btn:hover {
    border-color: var(--gold-bright);
    background-color: #202D48;
}

.btn:active {
    background-color: #0E1628;
}

.btn:disabled {
    opacity: 0.4;
}

.btn-primary {
    background-color: var(--gold-button);
    border-color: #F3DDA0;
    color: var(--gold-ink);
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.btn-primary:hover {
    background-color: var(--gold-bright);
    border-color: #FFF0C8;
}

.btn-primary:active {
    background-color: #B8954F;
}

.btn-secondary {
    background-color: transparent;
    border-color: var(--gold);
    color: var(--gold-bright);
}

.btn-large {
    min-height: 125px;
    font-size: 43px;
}

.btn-small {
    min-height: 72px;
    padding: 5px 24px;
    margin: 0 0 0 14px;
}

.btn-toggled {
    background-color: #0E1628;
    border-color: var(--gold-bright);
    color: var(--gold-bright);
}

/* ---- Main menu ----------------------------------------------------------- */

.menu-card {
    width: 1104px;
    padding: 86px 96px;
}

.logo {
    font-size: 134px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    letter-spacing: 29px;
}

.logo-sub {
    font-size: 53px;
    -unity-font-style: bold;
    color: var(--text);
    letter-spacing: 38px;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.tagline {
    font-size: 34px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-bottom: 58px;
}

.version {
    position: absolute;
    right: 48px;
    bottom: 34px;
}

/* ---- Star map ------------------------------------------------------------ */

.sidebar {
    width: 768px;
    margin: 38px;
}

.map-area {
    flex-grow: 1;
    padding: 67px 96px 96px 58px;
}

.map-canvas {
    flex-grow: 1;
    margin-top: 58px;
}

.star-map {
    flex-grow: 1;
}

.node {
    position: absolute;
    margin: 0;
    font-size: 31px;
    border-width: 5px;
    border-radius: 19px;
}

.node--battle { border-color: var(--gold); }
.node--elite { border-color: var(--elite); }
.node--supply { border-color: var(--supply); }
.node--boss { border-color: var(--enemy); background-color: #3A1F17; }

.node--open {
    background-color: #2A2410;
    border-color: var(--gold-bright);
}

.node--closed {
    opacity: 0.45;
}

.node--closed:hover {
    background-color: var(--panel-raised);
}

.node--visited {
    opacity: 0.8;
    background-color: #0F2A28;
    border-color: var(--supply);
}

.node--current {
    opacity: 1;
    border-color: var(--supply);
    background-color: #164038;
}

.info-box {
    background-color: var(--panel-raised);
    border-left-width: 5px;
    border-color: var(--gold);
    border-radius: 2px;
    padding: 24px 29px;
    margin-bottom: 19px;
}

.messages {
    margin-top: 24px;
}

/* ---- Deployment and battle bars ---------------------------------------- */

.topbar {
    flex-direction: row;
    align-items: center;
    height: 125px;
    padding: 0 38px;
    background-color: var(--panel);
    border-bottom-width: 2px;
    border-color: var(--gold);
}

.topbar .h2 {
    margin-bottom: 0;
}

.hint {
    margin-left: 58px;
}

.side-left {
    width: 600px;
    margin: 19px;
}

.side-right {
    width: 816px;
    margin: 19px;
}

.roster {
    margin: 14px 0;
}

.roster-card {
    flex-direction: column;
    align-items: stretch;
    -unity-text-align: upper-left;
    padding: 14px 24px;
    margin: 0 0 14px 0;
}

.roster-card-head {
    flex-direction: row;
    justify-content: space-between;
}

.roster-card-title {
    font-size: 34px;
    -unity-font-style: bold;
}

.roster-card-state {
    font-size: 29px;
    color: var(--muted);
}

.roster-card--deployed {
    border-color: var(--good);
    background-color: #17271F;
}

.roster-card--selected {
    border-color: var(--supply);
    background-color: #102A2A;
}

.count {
    min-width: 336px;
}

.speeds {
    margin-left: 58px;
}

.feed {
    width: 720px;
    margin: 19px 29px;
}

.bottombar {
    flex-direction: row;
    align-items: center;
    height: 269px;
    padding: 24px 38px;
    background-color: var(--panel);
    border-top-width: 2px;
    border-color: var(--gold);
}

.supply-box {
    width: 864px;
}

.pips {
    margin: 14px 0;
}

.pip {
    width: 62px;
    height: 29px;
    margin-right: 10px;
    background-color: #202838;
    border-radius: 5px;
}

.pip--full {
    background-color: var(--supply);
}

.net-box {
    width: 720px;
    margin-left: 58px;
}

.skill {
    width: 408px;
    height: 206px;
    margin: 0 0 0 24px;
    flex-direction: column;
    justify-content: center;
}

.skill-name {
    font-size: 38px;
    -unity-font-style: bold;
}

.skill--armed {
    border-color: var(--bad);
    background-color: #3A1A1A;
}

/* ---- Portrait (root gets .portrait when the screen is taller than wide) ----
 * Layouts are then 2160 px wide (see UiRoot). The board stands upright in the
 * middle; deployment panels move below it and the battle bars wrap.
 */

.portrait .hint {
    display: none;
}

.portrait .deploy-body .side-left {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 840px;
    height: 1180px;
}

.portrait .deploy-body .side-right {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 1224px;
    height: 1180px;
}

.portrait .board-area {
    margin-bottom: 1218px;
}

.portrait .topbar {
    flex-wrap: wrap;
    height: auto;
    min-height: 125px;
    padding: 14px 38px;
}

.portrait .count {
    min-width: 0;
    margin-right: 24px;
}

.portrait .speeds {
    margin-left: 24px;
}

.portrait .battle-body .feed {
    position: absolute;
    top: 0;
    right: 0;
    width: 880px;
}

.portrait .battle-bottombar {
    flex-wrap: wrap;
    height: auto;
}

.portrait .supply-box {
    width: 1040px;
}

.portrait .net-box {
    width: 960px;
    margin-left: 38px;
}

.portrait .skill {
    margin: 14px 24px 0 0;
}

/* ---- Rewards ------------------------------------------------------------- */

.cards {
    margin: 58px 0;
}

.reward-card {
    width: 672px;
    height: 912px;
    margin: 0 34px;
}

.stats {
    margin-top: 19px;
}

/* ---- Dialogs ------------------------------------------------------------- */

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-dim);
    align-items: center;
    justify-content: center;
}

.dialog {
    width: 1440px;
    padding: 58px 67px;
}

.dialog-body {
    margin: 24px 0 38px 0;
}

.dialog-buttons {
    flex-direction: column;
}

.dialog--win { border-color: var(--good); }
.dialog--loss { border-color: var(--bad); }

/* ---- Labels over the ships ---------------------------------------------- */

.unit-tag {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
}

.unit-tag-status {
    font-size: 26px;
    color: var(--text);
    margin: 0;
}

.unit-tag-name {
    font-size: 26px;
    color: var(--muted);
    margin: 0;
}

.unit-bars {
    height: 14px;
    background-color: rgba(0, 0, 0, 0.6);
    margin: 2px 0;
}

.unit-bars--small { width: 82px; }
.unit-bars--large { width: 125px; }

.unit-bar-hp {
    position: absolute;
    left: 0;
    top: 0;
    height: 7px;
}

.unit-bar-hp--player { background-color: #66E680; }
.unit-bar-hp--enemy { background-color: #FF8059; }

.unit-bar-shield {
    position: absolute;
    left: 0;
    top: 7px;
    height: 5px;
    background-color: #73CCFF;
}

/* ---- Replays ------------------------------------------------------------- */

.replay-banner {
    align-self: center;
    margin-top: 14px;
    padding: 10px 38px;
    font-size: 34px;
    color: var(--gold-bright);
    background-color: var(--bg-dim);
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 5px;
}

