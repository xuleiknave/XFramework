<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="save-slots" class="screen slots" picking-mode="Ignore">
        <ui:VisualElement class="slots-head" picking-mode="Ignore">
            <ui:Label text="STARLINE" class="logo" picking-mode="Ignore" />
            <ui:VisualElement class="row divider" picking-mode="Ignore">
                <ui:VisualElement class="divider-line" picking-mode="Ignore" />
                <ui:VisualElement class="diamond" picking-mode="Ignore" />
                <ui:VisualElement class="divider-line" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="#slots.logo_sub" class="logo-sub" picking-mode="Ignore" />
            <ui:Label text="#slots.tagline" class="tagline" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="slots" class="row slots-row" picking-mode="Ignore" />
        <ui:Button name="enter" text="#slots.enter" class="btn btn-primary btn-large slots-enter" />
        <ui:Label text="#slots.enter_hint" class="small muted" picking-mode="Ignore" />
        <ui:VisualElement class="row slots-corner" picking-mode="Ignore">
            <ui:Button name="back" text="#run_end.menu" class="btn btn-secondary btn-small" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
