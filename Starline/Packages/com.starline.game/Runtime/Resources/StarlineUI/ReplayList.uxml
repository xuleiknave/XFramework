<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="screen backdrop center" picking-mode="Ignore">
        <ui:VisualElement class="panel replay-panel">
            <ui:Label text="我的录像" class="h1" />
            <ui:Label text="每个关卡保留你战力最低的一场胜利。数值或规则更新后，旧版本的录像无法回放。" class="small muted" />
            <ui:ScrollView name="list" class="grow replay-list" />
            <ui:Label name="empty" text="还没有录像：在远征中打赢一场战斗就会自动保存。" class="body muted" />
            <ui:Button name="back" text="返回主菜单" class="btn btn-secondary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
