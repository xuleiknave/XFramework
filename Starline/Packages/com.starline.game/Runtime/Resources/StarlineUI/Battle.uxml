<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="screen column" picking-mode="Ignore">
        <ui:VisualElement class="topbar">
            <ui:Label name="player-count" class="h2 count" />
            <ui:VisualElement class="grow" picking-mode="Ignore" />
            <ui:Label name="time" class="h2" />
            <ui:VisualElement class="grow" picking-mode="Ignore" />
            <ui:Label name="enemy-count" class="h2 count" />
            <ui:VisualElement name="speeds" class="row speeds" />
            <ui:Button name="pause" text="暂停" class="btn btn-small" />
            <ui:Button name="skip" text="跳过 »" class="btn btn-small" />
        </ui:VisualElement>
        <ui:Label name="mode" class="replay-banner" picking-mode="Ignore" />
        <ui:VisualElement class="row grow" picking-mode="Ignore">
            <ui:VisualElement class="grow" picking-mode="Ignore" />
            <ui:VisualElement name="feed" class="feed" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="bottombar">
            <ui:VisualElement class="supply-box">
                <ui:Label name="points" class="body" />
                <ui:VisualElement name="pips" class="row pips" />
                <ui:Label name="hint" text="角色自动战斗，你只需决定何时释放指挥官技能。" class="small muted" />
            </ui:VisualElement>
            <ui:VisualElement class="net-box">
                <ui:Label name="player-net" class="body" />
                <ui:Label name="enemy-net" class="body" />
            </ui:VisualElement>
            <ui:VisualElement class="grow" picking-mode="Ignore" />
            <ui:VisualElement name="skills" class="row skills" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
