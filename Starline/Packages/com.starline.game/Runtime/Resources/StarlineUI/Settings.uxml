<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="settings" class="screen settings" picking-mode="Ignore">
        <ui:VisualElement class="shade-left" picking-mode="Ignore" />

        <ui:VisualElement class="settings-column" picking-mode="Ignore">
            <ui:Label text="SETTINGS" class="settings-logo" picking-mode="Ignore" />
            <ui:VisualElement class="row menu-divider" picking-mode="Ignore">
                <ui:VisualElement class="diamond diamond--start" picking-mode="Ignore" />
                <ui:VisualElement class="divider-line" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="#menu.settings" class="menu-title" picking-mode="Ignore" />

            <ui:Button name="tab-language" class="menu-item settings-tab">
                <ui:Label text="#settings.tab_language" class="menu-item-title" picking-mode="Ignore" />
                <ui:Label name="tab-language-sub" class="menu-item-sub" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="tab-graphics" class="menu-item settings-tab">
                <ui:Label text="#settings.tab_graphics" class="menu-item-title" picking-mode="Ignore" />
                <ui:Label name="tab-graphics-sub" class="menu-item-sub" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="tab-audio" class="menu-item settings-tab">
                <ui:Label text="#settings.tab_audio" class="menu-item-title" picking-mode="Ignore" />
                <ui:Label text="#settings.coming_soon" class="menu-item-sub" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="tab-controls" class="menu-item settings-tab">
                <ui:Label text="#settings.tab_controls" class="menu-item-title" picking-mode="Ignore" />
                <ui:Label text="#settings.coming_soon" class="menu-item-sub" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement class="panel settings-panel">
            <ui:VisualElement class="row settings-head" picking-mode="Ignore">
                <ui:Label name="page-title" class="h2 settings-page-title" picking-mode="Ignore" />
                <ui:Label text="#settings.auto_save" class="small muted" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="page-language" picking-mode="Ignore">
                <ui:Label text="#settings.language" class="settings-key" picking-mode="Ignore" />
                <ui:Label text="#settings.language_desc" class="settings-desc" picking-mode="Ignore" />
                <ui:VisualElement name="languages" class="row settings-languages" picking-mode="Ignore" />
                <ui:VisualElement class="settings-notes" picking-mode="Ignore">
                    <ui:Label text="#settings.language_note_default" class="settings-desc" picking-mode="Ignore" />
                    <ui:Label text="#settings.language_note_voice" class="settings-desc" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="page-graphics" picking-mode="Ignore">
                <ui:VisualElement class="row settings-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.preset" class="settings-key" picking-mode="Ignore" />
                        <ui:Label text="#settings.preset_desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-preset" class="row settings-seg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row settings-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.display" class="settings-key" picking-mode="Ignore" />
                        <ui:Label text="#settings.display_desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-display" class="row settings-seg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row settings-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.resolution" class="settings-key" picking-mode="Ignore" />
                        <ui:Label name="resolution-desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row settings-stepper" picking-mode="Ignore">
                        <ui:Button name="res-prev" text="‹" class="btn settings-arrow" />
                        <ui:Label name="res-value" class="settings-value" picking-mode="Ignore" />
                        <ui:Button name="res-next" text="›" class="btn settings-arrow" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="row settings-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.vsync" class="settings-key" picking-mode="Ignore" />
                        <ui:Label text="#settings.vsync_desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-vsync" class="row settings-seg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row settings-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.frame_rate" class="settings-key" picking-mode="Ignore" />
                        <ui:Label text="#settings.frame_rate_desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-frame-rate" class="row settings-seg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row settings-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.render_scale" class="settings-key" picking-mode="Ignore" />
                        <ui:Label text="#settings.render_scale_desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-render-scale" class="row settings-seg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row settings-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.antialiasing" class="settings-key" picking-mode="Ignore" />
                        <ui:Label text="#settings.antialiasing_desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-antialiasing" class="row settings-seg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row settings-row" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.shadows" class="settings-key" picking-mode="Ignore" />
                        <ui:Label text="#settings.shadows_desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-shadows" class="row settings-seg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row settings-row settings-row--last" picking-mode="Ignore">
                    <ui:VisualElement class="settings-row-text" picking-mode="Ignore">
                        <ui:Label text="#settings.bloom" class="settings-key" picking-mode="Ignore" />
                        <ui:Label text="#settings.bloom_desc" class="settings-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-bloom" class="row settings-seg" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement class="row settings-foot" picking-mode="Ignore">
                    <ui:Button name="reset-graphics" text="#settings.reset_graphics" class="btn btn-small btn-text settings-reset" />
                    <ui:Label name="device" class="small settings-device" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="row settings-corner" picking-mode="Ignore">
            <ui:Label text="#settings.esc_hint" class="small settings-device" picking-mode="Ignore" />
            <ui:Button name="back" text="#run_end.menu" class="btn btn-secondary btn-small" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
