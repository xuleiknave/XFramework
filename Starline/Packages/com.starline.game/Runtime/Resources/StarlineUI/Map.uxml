<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="screen backdrop row" picking-mode="Ignore">
        <ui:VisualElement name="sidebar" class="panel sidebar">
            <ui:Label text="#map.army" class="h2" />
            <ui:Label name="durability" class="stat" />
            <ui:Label name="command" class="small muted" />
            <ui:Label name="relays" class="small muted" />
            <ui:Label name="record" class="small muted" />
            <ui:Label text="#map.roster" class="h3 section" />
            <ui:VisualElement name="fleet-list" />
            <ui:Label text="#map.merge_hint" class="small muted" />
            <ui:VisualElement name="messages" class="messages" />
            <ui:VisualElement class="spacer" />
            <ui:VisualElement name="node-info" class="info-box">
                <ui:Label name="node-title" class="h3" />
                <ui:Label name="node-briefing" class="body" />
                <ui:Label name="node-reward" class="small good" />
            </ui:VisualElement>
            <ui:Button name="abandon" text="#map.abandon" class="btn btn-secondary" />
        </ui:VisualElement>
        <ui:VisualElement class="map-area" picking-mode="Ignore">
            <ui:Label name="act-title" class="h1" />
            <ui:Label text="#map.route_hint" class="small muted" />
            <ui:VisualElement name="map-canvas" class="map-canvas" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
