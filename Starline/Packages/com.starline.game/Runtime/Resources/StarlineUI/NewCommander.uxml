<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="modal-backdrop">
        <ui:VisualElement class="panel dialog name-dialog">
            <ui:Label name="slot-label" class="small muted eyebrow" />
            <ui:Label text="#commander.title" class="h2" />
            <ui:Label text="#commander.body" class="body dialog-body" />
            <ui:Label text="#commander.name_label" class="small muted" />
            <ui:TextField name="name" max-length="8" class="name-field" />
            <ui:VisualElement class="row name-hints">
                <ui:Label text="#commander.name_hint" class="small muted" />
                <ui:Label name="count" class="small muted" />
            </ui:VisualElement>
            <ui:Label name="error" class="small bad name-error" />
            <ui:VisualElement class="row name-buttons">
                <ui:Button name="confirm" text="#commander.confirm" class="btn btn-primary grow" />
                <ui:Button name="cancel" text="#common.cancel" class="btn btn-secondary grow" />
            </ui:VisualElement>
            <ui:VisualElement class="star-node star-node--tl" picking-mode="Ignore" />
            <ui:VisualElement class="star-node star-node--br" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
