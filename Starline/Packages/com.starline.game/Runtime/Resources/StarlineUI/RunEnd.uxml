<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="screen backdrop center" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="panel dialog">
            <ui:Label name="title" class="h1" />
            <ui:Label name="story" class="body dialog-body" />
            <ui:Label name="summary" class="small muted" />
            <ui:VisualElement class="dialog-buttons">
                <ui:Button name="again" text="#run_end.again" class="btn btn-primary" />
                <ui:Button name="menu" text="#run_end.menu" class="btn btn-secondary" />
            </ui:VisualElement>
            <ui:VisualElement class="star-node star-node--tl" picking-mode="Ignore" />
            <ui:VisualElement class="star-node star-node--br" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
