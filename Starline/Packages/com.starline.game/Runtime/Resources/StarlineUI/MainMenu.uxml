<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="main-menu" class="screen backdrop center" picking-mode="Ignore">
        <ui:VisualElement class="panel menu-card">
            <ui:Label text="STARLINE" class="logo" />
            <ui:Label text="星 线" class="logo-sub" />
            <ui:Label text="蜂群切断了连接人类殖民地的星线。重新点亮它。" class="tagline" />
            <ui:Button name="start" text="开始远征" class="btn btn-primary btn-large" />
            <ui:Button name="continue" text="继续远征（下一阶段：存档）" class="btn btn-large" />
            <ui:Button name="settings" text="设置（下一阶段）" class="btn btn-large" />
            <ui:Button name="quit" text="退出游戏" class="btn btn-large btn-secondary" />
        </ui:VisualElement>
        <ui:Label name="version" class="version small muted" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
