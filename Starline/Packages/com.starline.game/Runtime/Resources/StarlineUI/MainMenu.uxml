<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="main-menu" class="screen backdrop center" picking-mode="Ignore">
        <ui:VisualElement class="panel menu-card">
            <ui:Label text="STARLINE" class="logo" />
            <ui:Label text="#menu.logo_sub" class="logo-sub" />
            <ui:Label text="#menu.tagline" class="tagline" />
            <ui:Button name="start" text="#menu.start" class="btn btn-primary btn-large" />
            <ui:Button name="continue" text="#menu.continue" class="btn btn-large" />
            <ui:Button name="settings" text="#menu.settings" class="btn btn-large" />
            <ui:Button name="quit" text="#menu.quit" class="btn btn-large btn-secondary" />
        </ui:VisualElement>
        <ui:Label name="version" class="version small muted" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
