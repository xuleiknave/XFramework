<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="screen backdrop center" picking-mode="Ignore">
        <ui:Label text="#reward.title" class="h1" />
        <ui:Label text="#reward.subtitle" class="body muted" />
        <ui:VisualElement name="cards" class="row cards" />
        <ui:Button name="skip" text="#reward.skip" class="btn btn-secondary" />
    </ui:VisualElement>
</ui:UXML>
