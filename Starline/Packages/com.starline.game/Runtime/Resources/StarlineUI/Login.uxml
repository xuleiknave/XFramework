<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="login" class="screen" picking-mode="Ignore">
        <ui:VisualElement class="shade-left" picking-mode="Ignore" />
        <ui:VisualElement class="shade-bottom" picking-mode="Ignore" />
        <ui:VisualElement class="menu-column" picking-mode="Ignore">
            <ui:Label text="STARLINE" class="menu-logo" picking-mode="Ignore" />
            <ui:VisualElement class="row menu-divider" picking-mode="Ignore">
                <ui:VisualElement class="diamond diamond--start" picking-mode="Ignore" />
                <ui:VisualElement class="divider-line" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="#menu.title" class="menu-title" picking-mode="Ignore" />
            <ui:Label text="#menu.tagline" class="menu-tagline login-tagline" picking-mode="Ignore" />

            <!-- Login card: one big button per login method, the progress or error right under it. -->
            <ui:VisualElement name="card" class="panel login-card" picking-mode="Ignore">
                <ui:Label text="#login.heading" class="login-heading" picking-mode="Ignore" />
                <ui:Label text="#login.heading_sub" class="login-heading-sub" picking-mode="Ignore" />

                <ui:Button name="login-uos" class="btn btn-primary login-main">
                    <ui:Label text="#login.uos" class="login-main-title" picking-mode="Ignore" />
                    <ui:Label text="#login.uos_sub" class="login-main-sub" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="row login-status-row" picking-mode="Ignore">
                    <ui:VisualElement name="spinner" class="login-spinner" picking-mode="Ignore" />
                    <ui:Label name="status" class="login-status" picking-mode="Ignore" />
                    <ui:Button name="cancel" text="#common.cancel" class="btn btn-secondary btn-small login-cancel" />
                </ui:VisualElement>

                <ui:VisualElement name="dev-section" class="login-dev" picking-mode="Ignore">
                    <ui:VisualElement class="row login-dev-head" picking-mode="Ignore">
                        <ui:VisualElement class="login-dev-line" picking-mode="Ignore" />
                        <ui:Label text="#login.dev_account" class="login-dev-title" picking-mode="Ignore" />
                        <ui:VisualElement class="login-dev-line" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row login-dev-row" picking-mode="Ignore">
                        <ui:TextField name="dev-account" class="name-field login-dev-field" />
                        <ui:Button name="login-dev" text="#login.dev" class="btn btn-secondary login-dev-button" />
                    </ui:VisualElement>
                    <ui:Label text="#login.dev_hint" class="small muted login-dev-hint" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="star-node star-node--tl" picking-mode="Ignore" />
                <ui:VisualElement class="star-node star-node--br" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="row login-corner" picking-mode="Ignore">
            <ui:Button name="settings" text="#menu.settings" class="btn btn-secondary btn-small" />
            <ui:Button name="quit" text="#menu.quit" class="btn btn-secondary btn-small" />
        </ui:VisualElement>
        <ui:Label name="version" class="menu-version small" picking-mode="Ignore" />
        <ui:VisualElement class="menu-place" picking-mode="Ignore">
            <ui:Label text="#menu.place" class="menu-place-title" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
