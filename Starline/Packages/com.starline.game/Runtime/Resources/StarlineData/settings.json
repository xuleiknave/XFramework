{
  "_说明": "设置界面的选项和画质预设（客户端读取，内核不用）。id 是存进玩家设置文件的值，name 是界面上显示的文字：以 # 开头的是 Localization/UI.csv 的 key，其余原样显示（语言名用各自的语言写，FXAA、数字不翻译）。",
  "defaultLanguage": "zh-Hans",
  "languages": [
    { "id": "zh-Hans", "name": "简体中文", "available": true, "status": "", "systemLanguages": ["ChineseSimplified", "Chinese"] },
    { "id": "en", "name": "English", "available": true, "status": "初稿 · Draft", "systemLanguages": ["English"] }
  ],
  "onName": "#settings.on",
  "offName": "#settings.off",
  "customPresetName": "#settings.custom",
  "defaultPreset": "high",
  "presets": [
    { "id": "low", "name": "#settings.level_low", "renderScale": 67, "antialiasing": "fxaa", "shadows": "off", "bloom": false },
    { "id": "medium", "name": "#settings.level_medium", "renderScale": 85, "antialiasing": "smaa", "shadows": "low", "bloom": true },
    { "id": "high", "name": "#settings.level_high", "renderScale": 100, "antialiasing": "smaa", "shadows": "medium", "bloom": true },
    { "id": "ultra", "name": "#settings.level_ultra", "renderScale": 100, "antialiasing": "msaa4", "shadows": "high", "bloom": true }
  ],
  "defaultDisplayMode": "fullscreen",
  "displayModes": [
    { "id": "fullscreen", "name": "#settings.display_fullscreen" },
    { "id": "borderless", "name": "#settings.display_borderless" },
    { "id": "windowed", "name": "#settings.display_windowed" }
  ],
  "displayConfirmSeconds": 15,
  "defaultVsync": true,
  "defaultFrameRate": 120,
  "frameRates": [
    { "value": 30, "name": "30" },
    { "value": 60, "name": "60" },
    { "value": 120, "name": "120" },
    { "value": 144, "name": "144" },
    { "value": 0, "name": "#settings.frame_rate_unlimited" }
  ],
  "renderScales": [
    { "value": 50, "name": "50%" },
    { "value": 67, "name": "67%" },
    { "value": 85, "name": "85%" },
    { "value": 100, "name": "100%" }
  ],
  "antialiasing": [
    { "id": "off", "name": "#settings.off", "msaa": 1 },
    { "id": "fxaa", "name": "FXAA", "msaa": 1 },
    { "id": "smaa", "name": "SMAA", "msaa": 1 },
    { "id": "msaa4", "name": "MSAA 4×", "msaa": 4 }
  ],
  "shadows": [
    { "id": "off", "name": "#settings.off", "distance": 0, "resolution": 0 },
    { "id": "low", "name": "#settings.level_low", "distance": 30, "resolution": 1024 },
    { "id": "medium", "name": "#settings.level_medium", "distance": 45, "resolution": 2048 },
    { "id": "high", "name": "#settings.level_high", "distance": 60, "resolution": 4096 }
  ]
}
