{
  "_说明": "战斗场景（设计文档 5.5）。名字、说明和效果文字在 Localization/Game.csv：tile.<id>.name / .description / .effect<n>（n 是 effects 里的第几条，从 1 开始），战场环境用 terrain.<id>.*。tiles 是棋盘上的特殊地块，terrains 是每章的战场环境。effects 里 stat 可选 Speed（移速倍率）、Range（射程加减，单位：格）、Damage（造成伤害倍率）、DamageTaken（受到伤害倍率）、RangedDamageTaken（受到远程伤害倍率）、AttackInterval（攻击间隔倍率，大于 1 变慢）、HpRegen（每秒回复最大生命的比例）、ShieldRegen（护盾回复倍率）、ManaRegen（接入魔网时法力恢复倍率）；factions / exceptFactions / roles 过滤生效对象，ground 为 true 时飞骑不受影响。地块对飞骑和建筑无效，exempt 里的阵营也不受影响。terrains 的 tiles 是生成器每方半场放置的 [地块, 最少, 最多]；linkRange / coverage 是全场魔网连线距离和覆盖的加成（格）。",
  "tiles": [
    {"id": "high_ground", "symbol": "^",
     "effects": [
       {"stat": "Range", "value": 1, "roles": ["Artillery", "PointDefense"]},
       {"stat": "RangedDamageTaken", "value": 0.85}]},
    {"id": "brush", "symbol": "*",
     "effects": [
       {"stat": "RangedDamageTaken", "value": 0.8}]},
    {"id": "shallows", "symbol": "~",
     "relayLink": 1,
     "effects": [
       {"stat": "Speed", "value": 0.7}]},
    {"id": "deep_water", "symbol": "#",
     "blocksDeploy": true, "relayLink": 1,
     "effects": [
       {"stat": "Speed", "value": 0.4}]},
    {"id": "quicksand", "symbol": "s",
     "exempt": ["Rangers"],
     "effects": [
       {"stat": "Speed", "value": 0.6}]},
    {"id": "marsh", "symbol": "m",
     "exempt": ["Elves"],
     "effects": [
       {"stat": "Speed", "value": 0.7},
       {"stat": "AttackInterval", "value": 1.1}]},
    {"id": "ice", "symbol": "i",
     "effects": [
       {"stat": "Speed", "value": 1.25},
       {"stat": "ShieldRegen", "value": 0}]},
    {"id": "bone_pile", "symbol": "x",
     "effects": [
       {"stat": "HpRegen", "value": 0.02, "factions": ["Undead"]}]},
    {"id": "mana_spring", "symbol": "+",
     "relayCoverage": 1},
    {"id": "drained", "symbol": "-",
     "noNetwork": true, "exempt": ["Undead"]}
  ],
  "terrains": [
    {"id": "plains",
     "tiles": [["high_ground", 2, 3], ["shallows", 0, 3]]},
    {"id": "forest",
     "effects": [
       {"stat": "Speed", "value": 1.15, "factions": ["Rangers", "Elves"]},
       {"stat": "Range", "value": -1, "roles": ["Artillery"]},
       {"stat": "Speed", "value": 0.9, "roles": ["Heavy"]}],
     "tiles": [["brush", 4, 6], ["high_ground", 0, 2]]},
    {"id": "desert",
     "effects": [
       {"stat": "Speed", "value": 0.9, "ground": true, "exceptFactions": ["Rangers"]},
       {"stat": "ManaRegen", "value": 0.6, "exceptFactions": ["Undead"]}],
     "tiles": [["quicksand", 2, 4], ["high_ground", 2, 3], ["drained", 1, 3]]},
    {"id": "lake",
     "effects": [
       {"stat": "Range", "value": -1, "roles": ["Artillery"]},
       {"stat": "ShieldRegen", "value": 1.3, "factions": ["Morningstar"]}],
     "tiles": [["shallows", 4, 6], ["deep_water", 2, 4]]}
  ]
}
